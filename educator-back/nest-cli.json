{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "assets/**/*",
        "outDir": "dist"
      },
      {
        "include": "mock/**/*",
        "outDir": "dist"
      },
      {
        "include": "mail/templates/**/*",
        "outDir": "dist"
      },
      {
        "include": "common/i18n/**/*",
        "outDir": "dist"
      }
    ]
  }
}
