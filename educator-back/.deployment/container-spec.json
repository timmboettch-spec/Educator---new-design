{
  "dev": {
    "vault": "akvdev1rwai",
    "cpu": "0.5",
    "memory": "1Gi",
    "replicas": {
      "min": 0,
      "max": 1
    },
    "reason": "Cost optimization for development environment. Single deployment instance sufficient for testing.",
    "env-vars": {
      "NODE_ENV": "development",
      "APP_PORT": "3000",
      "APP_URL": "https://dev.educatorbe.realityworksai.com",
      "FRONTEND_URL": "https://dev.educator.realityworksai.com",
      "MAIL_FROM": "no-reply@dev.curionn.com",
      "SMTP_HOST": "smtp.sendgrid.net",
      "SMTP_PORT": "587",
      "SMTP_FROM": "no-reply@realityworksai.com",
      "AZURE_KEY_VAULT_URL": "https://akvdev1rwai.vault.azure.net",
      "AZURE_KEY_VAULT_SECRET_PREFIX": "edu-",
      "AZURE_SHARED_KEY_VAULT_URL": "https://akvdev1rwai.vault.azure.net",
      "DB_HOST": "apg-dev-edu.postgres.database.azure.com",
      "DB_PORT": "5432",
      "DB_NAME": "educator_dev"
    },
    "secrets": {
      "DB_USERNAME": "edu-db-username",
      "DB_PASSWORD": "edu-db-password",
      "JWT_SECRET": "edu-jwt-secret",
      "JWT_EXPIRES_IN": "edu-jwt-expires-in",
      "AZURE_STORAGE_CONNECTION_STRING": "edu-azure-storage-connection-string",
      "AZURE_STORAGE_ACCOUNT": "edu-azure-storage-account",
      "AZURE_STORAGE_CONTAINER": "edu-azure-storage-container",
      "RATE_LIMIT_PUBLIC_LIMIT": "edu-rate-limit-public-limit",
      "RATE_LIMIT_PUBLIC_TTL": "edu-rate-limit-public-ttl",
      "DEFAULT_THROTTLE_LIMIT": "edu-default-throttle-limit",
      "DEFAULT_THROTTLE_TTL_MS": "edu-default-throttle-ttl-ms",
      "RATE_LIMIT_FALLBACK_RETRY_AFTER_SECONDS": "edu-rate-limit-fallback-retry-after-seconds"
    },
    "probes": {
      "liveness": {
        "type": "http",
        "path": "/health",
        "port": 3000,
        "initialDelaySeconds": 30,
        "periodSeconds": 10,
        "timeoutSeconds": 5,
        "failureThreshold": 3
      },
      "readiness": {
        "type": "http",
        "path": "/health",
        "port": 3000,
        "initialDelaySeconds": 10,
        "periodSeconds": 5,
        "timeoutSeconds": 3,
        "failureThreshold": 2
      }
    }
  },
