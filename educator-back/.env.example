# Educator App backend - local environment variables
# Copy to .env and fill in real values. Never commit .env.

AZURE_KEY_VAULT_URL=https://akvdev1rwai.vault.azure.net
AZURE_KEY_VAULT_SECRET_PREFIX=edu-
# Optional shared vault for cross-app secrets
AZURE_SHARED_KEY_VAULT_URL=https://akv-all1-all.vault.azure.net

# Client ID of this app's user-assigned managed identity. Selects which
# identity ManagedIdentityCredential authenticates as (Graph mail send,
# Redis, App Insights Query API). Locally, leave empty to use
# DefaultAzureCredential's other fallbacks (az login, etc.) instead.
AZURE_CLIENT_ID=

# ── Database (PostgreSQL) ────────────────────────────────────────────────
DB_HOST=psql-dev1-rwai-edu.postgres.database.azure.com
DB_PORT=5432
DB_USERNAME=sqladmin
DB_PASSWORD=
DB_NAME=educator_dev
ALLOW_NONSSL=false
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_ACQUIRE_TIMEOUT_MS=5000
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ── URLs ─────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
STUDENT_FRONTEND_URL=http://localhost:5174
APP_PORT=3000
# Platform-injected port (e.g. Azure Container Apps) — only used for a log message
# in main.ts; APP_PORT is what the server actually binds to.
PORT=

# Public URL for LTI redirects (launch/callback). Required for ngrok/deployed envs.
# In deployed envs (dev/qa/prod): injected from Key Vault secret 'edu-api-base-url'.
# REQUIRED in deployed envs — a missing value fails app startup (LtiKeyService).
API_BASE_URL=
LMS_ENABLE_LTI_AUTO_PROVISION=true

# LMS live smoke tests (tests/integration/lms/live-smoke/) — 3 vars per LMS, from LTI launch payload
MOODLE_DEV_BASE_URL=https://moodle-dev.yourschool.edu
MOODLE_DEV_TEST_COURSE_ID=42
MOODLE_DEV_NRPS_URL=

CANVAS_DEV_BASE_URL=https://canvas.test.instructure.com
CANVAS_DEV_TEST_COURSE_ID=123
CANVAS_DEV_NRPS_URL=

API_TIMEOUT_MS=60000
SERVER_KEEP_ALIVE_TIMEOUT_MS=65000
SERVER_HEADERS_TIMEOUT_MS=66000
HEAP_LOG_INTERVAL_MS=60000

# Days before a due date to start surfacing reminder notifications.
NOTIFICATION_DUE_REMINDER_DAYS=

# ── Mail (Azure Communication Services Email) ────────────────────────────
# Sender mailbox — dev.curionn.com (dev) / qa.curionn.com (qa) / realityworks.com (prod).
# Domain is provisioned as a CustomerManaged ACS Email domain (see
# infra/modules/acsEmail.bicep, docs/DEPLOYMENT.md "Azure Communication
# Services mail").
MAIL_FROM=no-reply@dev.curionn.com

# Selects MailService's transport — 'acs' (default, real delivery) or 'noop'
# (logs and skips sending; useful in automated test/CI environments so real
# sender-domain reputation isn't at risk). Optional, defaults to 'acs'.
MAIL_PROVIDER=

# ACS Communication Services endpoint (resource-derived, see acsEmail.bicep's
# `endpoint` output — https://acs-rwai-edu-<env>.<region>.communication.azure.com).
# Required unless MAIL_PROVIDER=noop.
ACS_ENDPOINT=

# Auth is ManagedIdentityCredential (AZURE_CLIENT_ID above), falling back to
# DefaultAzureCredential (az login) locally when AZURE_CLIENT_ID is unset —
# no client secret / connection string stored anywhere.

# Max ms AcsMailProvider.send() waits for ACS's send operation to finish
# before returning to the caller and letting the poll finish in the
# background — keeps a slow/stuck ACS send (e.g. quota/suppression-list
# handling) from blocking the whole HTTP request until the global API
# timeout (60s) fires a generic 408. Optional, defaults to 20000.
ACS_SEND_POLL_TIMEOUT_MS=20000

# Base test mailbox that tests/api/utils/env.ts's testEmail() sub-addresses
# (test+<prefix>-<timestamp>@<domain>). MailService always treats a "+"-tagged
# sub-address of this mailbox as synthetic and skips the real send,
# regardless of EMAIL_MODE/MAIL_PROVIDER — see
# src/mail/mail-test-recipient.util.ts. Optional, defaults to test@curionn.com.
TEST_EMAIL_ADDRESS=test@curionn.com

# Logo shown in report/notification emails.
EMAIL_LOGO_URL=

# ── Azure Blob Storage ────────────────────────────────────────────────────
# In deployed environments these are injected from per-environment Key Vaults:
#   akvdev1rwai / akvqa1rwai / akvprod1rwai
#   KV secret name → env var
# AZURE_STORAGE_ACCOUNT and AZURE_STORAGE_CONTAINER are set per-environment
# in .deployment/container-spec.json env-vars.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_ACCOUNT=

# Simulation catalog JSON container (units.json, scenarios.json, transcripts, sales-order lines).
# Read by the src/database/seeders/* blob imports and health.service.ts.
# In deployed envs this comes from KV secret 'edu-azure-blob-container-name'.
AZURE_BLOB_CONTAINER_NAME=json-data
# Optional virtual folder/prefix inside the container.
AZURE_BLOB_PREFIX=
BLOB_DOWNLOAD_TIMEOUT_MS=20000

# ── Cache (Redis) ────────────────────────────────────────────────────────
# In deployed envs this is Azure Managed Redis. Two mutually exclusive auth
# modes, selected by IS_MANAGED_REDIS — see src/redis/redis.provider.ts.
#
# REDIS_HOST is REQUIRED unless NODE_ENV=development (or test). Leaving it
# unset in development runs LTI state/session in per-process memory, which
# only works on a single replica; any other NODE_ENV fails to boot rather
# than silently downgrading. Once REDIS_HOST is set it is used unconditionally
# — an unreachable Redis fails the LTI launch, it never falls back to memory.

# IS_MANAGED_REDIS=false (default): local/access-key auth (unchanged).
# Injected from Key Vault secrets 'edu-redis-host' / 'edu-redis-port' /
# 'edu-redis-password' in deployed envs. Locally, point at a plain
# `redis-server` on localhost (no TLS/password needed).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_CACHE_TTL_SECONDS=

# IS_MANAGED_REDIS=true: Entra ID auth via the System-assigned Managed
# Identity on the compute resource (Container App / App Service / VM) — no
# secrets in code. REDIS_USERNAME is that identity's object (principal)
# ID; TLS is forced on and REDIS_PORT should be Redis's TLS port (6380 by
# default, or the Managed Redis Enterprise port if different).
#
# Infra prerequisites (NOT handled by this code — must be done in Azure first):
#   1. System-assigned identity enabled on the compute resource.
#   2. Entra ID authentication enabled on the Redis cache.
#   3. The Redis data-plane RBAC role assigned to that identity's object ID.
IS_MANAGED_REDIS=false
REDIS_USERNAME=

# ── Socket.IO cross-replica delivery (ADR-0008) ──────────────────────────
# Pushes are shared between replicas through the Redis Socket.IO adapter.
# Defaults to on; only 'false' reverts to the in-memory adapter (delivery is
# then local to the replica holding the socket — single replica only).
# Ignored when no Redis client exists (REDIS_HOST unset in development).
SOCKET_IO_REDIS_ADAPTER_ENABLED=true

# ── LTI fallback signing key ──────────────────────────────────────────────
# Used for LTI 1.3 testing when the platform JWKS endpoint is unavailable.
# In deployed envs these come from KV secrets in the per-env vault (akvdev1rwai etc.):
#   edu-lti-fallback-key-id      → LTI_FALLBACK_KEY_ID
#   edu-lti-fallback-private-key-pem → LTI_FALLBACK_PRIVATE_KEY_PEM
LTI_FALLBACK_KEY_ID=
LTI_FALLBACK_PRIVATE_KEY_PEM=
LTI_STUDENT_CODE_SECRET=

# Encrypts LMS API tokens and LTI platform private keys at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
# Deployed envs: KV secret 'edu-lms-secrets-encryption-key'.
# No fallback by design — never chain to JWT_SECRET (its 90-day rotation would
# make every stored secret undecryptable).
#
# Rotation — skipping a step loses the data permanently:
#   1. set KEY=<new> and KEY_PREVIOUS=<old>
#   2. deploy
#   3. npm run reencrypt:lms-secrets
#   4. remove KEY_PREVIOUS and redeploy
LMS_SECRETS_ENCRYPTION_KEY=

# Optional. Set only during a rotation; remove after step 3.
LMS_SECRETS_ENCRYPTION_KEY_PREVIOUS=

# Moodle LMS integration (src/lms/adapters/moodle.adapter.ts).
MOODLE_URL=
MOODLE_WS_TOKEN=

# ── Google Classroom OAuth (src/google) ───────────────────────────────────
# Deployed envs: KV secrets in the per-env vault (akvdev1rwai etc.):
#   edu-google-classroom-oauth-client-id     → GOOGLE_CLASSROOM_CLIENT_ID
#   edu-google-classroom-oauth-client-secret → GOOGLE_CLASSROOM_CLIENT_SECRET
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=
# Optional GIS / student Sign-in client id (defaults to GOOGLE_CLASSROOM_CLIENT_ID).
# Must match an authorized redirect URI on the Google OAuth web client.
GOOGLE_CLASSROOM_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Optional override (space-separated). Defaults to openid + email + 8 Classroom DevOps scopes.
# Include openid and email if you override, or "Connected as" will stay empty.
# GOOGLE_CLASSROOM_SCOPES=
# Frontend path after OAuth callback (appended to FRONTEND_URL).
GOOGLE_CLASSROOM_SUCCESS_REDIRECT_PATH=/google-classroom
# Incremental OAuth scopes (Google include_granted_scopes). Default true.
# GOOGLE_CLASSROOM_INCLUDE_GRANTED_SCOPES=false

# ── Rate limiting / throttle ───────────────────────────────────────────────
# All optional — see src/common/constants/throttle.constants.ts for defaults.
AUTH_LOGIN_LIMIT=5
AUTH_LOGIN_TTL=60000
AUTH_FORGOT_PASSWORD_LIMIT=6
AUTH_FORGOT_PASSWORD_TTL=900000
AUTH_FORGOT_PASSWORD_COOLDOWN_SECONDS=60
AUTH_FORGOT_PASSWORD_IP_LIMIT=10
AUTH_FORGOT_PASSWORD_IP_WINDOW_SECONDS=900
AUTH_VERIFY_OTP_LIMIT=5
AUTH_VERIFY_OTP_TTL=600000
AUTH_RESET_PASSWORD_LIMIT=3
AUTH_RESET_PASSWORD_TTL=900000
LTI_SESSION_EXCHANGE_LIMIT=10
LTI_SESSION_EXCHANGE_TTL=60000
# Classroom LTI burst (login/callback/launch/session-exchange) — per IP, TTL in seconds.
# Shared bucket across those routes so a school NAT can open a full class without 429s.
LTI_LAUNCH_RATE_LIMIT=60
LTI_LAUNCH_RATE_TTL=10
RATE_LIMIT_AUTH_LIMIT=5
RATE_LIMIT_AUTH_TTL=1
RATE_LIMIT_PUBLIC_LIMIT=3
RATE_LIMIT_PUBLIC_TTL=1
DEFAULT_THROTTLE_LIMIT=5
DEFAULT_THROTTLE_TTL_MS=1000
RATE_LIMIT_FALLBACK_RETRY_AFTER_SECONDS=60

# ── Google Classroom ────────────────────────────────────────────────────
# Path (relative to FRONTEND_URL) the frontend redirects to after a
# successful Google Classroom OAuth connect.
# In deployed envs (dev/qa/prod): injected from Key Vault secret 'edu-google-classroom-success-redirect-path'.
GOOGLE_CLASSROOM_SUCCESS_REDIRECT_PATH=/google-classroom

# ── Student-backend consolidation ────────────────────────────────────────
# Blob container for student uploads (distinct from AZURE_BLOB_CONTAINER_NAME's
# scenario/report JSON container). In deployed envs: KV secret 'edu-azure-blob-data-container-name'.
AZURE_BLOB_DATA_CONTAINER_NAME=rwai-data-files
# Blob container for TTS voice-profile reference wavs (voices/<id>/voice.wav).
# Optional; defaults to 'voice-profiles'. Deployed envs set it as a plain value in
# infra/modules/containerApp-backend.bicep (not a secret).
AZURE_BLOB_VOICE_PROFILES_CONTAINER_NAME=voice-profiles
# Bounded concurrency for scenario JSON hydration from blob storage.
SCENARIO_HYDRATION_CONCURRENCY=32
# Cache tuning for the scenario JSON data service.
JSON_CACHE_METADATA_CHECK_INTERVAL_MS=3000
LOCALIZED_SCENARIOS_CACHE_TTL_MS=30000

# ── Application Insights (telemetry analytics query API) ─────────────────
# Connection string for App Insights telemetry (in deployed envs this is
# resource-derived directly from the shared appi-all1-rwai resource, not KV).
APPLICATIONINSIGHTS_CONNECTION_STRING=
# 'api-key' for local dev, 'managed-identity' in deployed envs (uses AZURE_CLIENT_ID,
# which the backend's own user-assigned identity supplies — granted Monitoring Reader).
APPINSIGHTS_AUTH_TYPE=api-key
# Falls back to extracting ApplicationId from APPLICATIONINSIGHTS_CONNECTION_STRING if unset.
APPLICATIONINSIGHTS_APP_ID=
APPLICATIONINSIGHTS_API_KEY=
AZURE_CLIENT_ID=

# ── Lifecycle telemetry ────────────────────────────────────────────────────
TELEMETRY_SAMPLING_PRIORITY=100
TELEMETRY_LIFECYCLE_ENABLED=true

# ── AI conversation ─────────────────────────────────────────────────────────
CONVERSATION_PROVIDER=ai
# AI gateway implementation (ADR-0012). Supported: openai (default), static (canned replies for local use, no API key).
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
# In deployed envs: KV secret 'edu-openai-api-key', seeded with the same value
# as HS-Online-AI's shared 'OPENAI-API-KEY' secret (same OpenAI account/key).
OPENAI_API_KEY=

# ── QA automation-only content ────────────────────────────────────────────
# Email of the sole account allowed to see/launch the automation-only unit
# (AUTO-UNIT-001) and simulation ("Pressure Injury Prevention Assessment").
# Every other account — any role — has that unit/simulation excluded from
# catalogs, libraries, dashboards, selectors, and search, and gets the
# standard not-found response on direct access.
# Required — if unset, the content is hidden from everyone, including the
# tester (fails closed). See src/common/utils/automation-access.service.ts.
AUTOMATION_TESTER_EMAIL=


# ── Speech engine (Phase 2 — not yet active) ────────────────────────────────
SPEECH_ENGINE_PROVIDER=openai-whisper
SPEECH_ENGINE_API_KEY=
SPEECH_ENGINE_API_URL=
SPEECH_ENGINE_MODEL=
SPEECH_ENGINE_LANGUAGE=en-US

# ── Report email ─────────────────────────────────────────────────────────────
# Sent via the unified MailService (Azure Communication Services Email,
# see MAIL_FROM / MAIL_PROVIDER / ACS_ENDPOINT above).
REPORT_EMAIL_TO=
# Set to 'skip' to use NoopMailProvider and prevent all real email delivery
# (recommended for local dev and required for API tests). Set to 'file' to
# save report emails to Blob Storage instead.
EMAIL_MODE=skip
# Optional explicit sender override for report emails only — omit to use
# MailService's own MAIL_FROM.
EMAIL_FROM=
