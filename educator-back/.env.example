# Educator App backend - local environment variables
# Copy to .env and fill in real values. Never commit .env.

AZURE_KEY_VAULT_URL=https://akvdev1rwai.vault.azure.net
AZURE_KEY_VAULT_SECRET_PREFIX=edu-
# Optional shared vault for cross-app secrets (GRAPH_CLIENT_ID etc.)
AZURE_SHARED_KEY_VAULT_URL=https://akv-all1-all.vault.azure.net

# ── Database (PostgreSQL) ────────────────────────────────────────────────
DB_HOST=psql-dev1-rwai-edu.postgres.database.azure.com
DB_PORT=5432
DB_USERNAME=sqladmin
DB_PASSWORD=
DB_NAME=educator_dev
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ── URLs ─────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
STUDENT_FRONTEND_URL=http://localhost:5174
APP_PORT=3000

# Public URL for LTI redirects (launch/callback). Required for ngrok/deployed envs.
# In deployed envs (dev/qa/prod): injected from Key Vault secret 'edu-api-base-url'.
API_BASE_URL=
LMS_ENABLE_LTI_AUTO_PROVISION=true

# ── Mail (Microsoft Graph) ───────────────────────────────────────────────
# Sender mailbox (must be allowed by the ApplicationAccessPolicy in Exchange Online)
MAIL_FROM=no-reply@realityworks.com

# Entra app registration used for Graph Mail.Send (application permission)
# Tenant ID and Client ID are not secret, but Client Secret IS.
# In Azure these come from Key Vault 'akv-all1-all' (RG: ARG-all1-rwai).
# Locally, generate a dev secret on the same app registration or use a
# separate dev-only registration to avoid sharing prod credentials.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ── Azure Blob Storage ────────────────────────────────────────────────────
# In deployed environments these are injected from per-environment Key Vaults:
#   akvdev1rwai / akvqa1rwai / akvprod1rwai
#   KV secret name → env var
# AZURE_STORAGE_ACCOUNT and AZURE_STORAGE_CONTAINER are set per-environment
# in .deployment/container-spec.json env-vars.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_ACCOUNT=

# Simulation catalog JSON container (units.json, scenarios.json, reports.json).
# Read by tutor-patient.service.ts and health.service.ts.
# In deployed envs this comes from KV secret 'edu-azure-blob-container-name'.
AZURE_BLOB_CONTAINER_NAME=json-data

# ── Cache (Redis) ────────────────────────────────────────────────────────
# In deployed envs this is Azure Managed Redis. Two mutually exclusive auth
# modes, selected by IS_MANAGED_REDIS — see src/redis/redis.provider.ts.

# IS_MANAGED_REDIS=false (default): local/access-key auth (unchanged).
# Injected from Key Vault secrets 'edu-redis-host' / 'edu-redis-port' /
# 'edu-redis-password' in deployed envs. Locally, point at a plain
# `redis-server` on localhost (no TLS/password needed).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# IS_MANAGED_REDIS=true: Entra ID auth via the System-assigned Managed
# Identity on the compute resource (Container App / App Service / VM) — no
# secrets in code. REDIS_USERNAME is that identity's object (principal)
# ID; TLS is forced on and REDIS_PORT should be Redis's TLS port (6380 by
# default, or the Managed Redis Enterprise port if different).
#
# Infra prerequisites (NOT handled by this code — must be done in Azure first):
#   1. System-assigned identity enabled on the compute resource.
#   2. Entra ID authentication enabled on the Redis cache.
#   3. The Redis data-plane RBAC role assigned to that identity's object ID.
IS_MANAGED_REDIS=false
REDIS_USERNAME=

# ── LTI fallback signing key ──────────────────────────────────────────────
# Used for LTI 1.3 testing when the platform JWKS endpoint is unavailable.
# In deployed envs these come from KV secrets in the per-env vault (akvdev1rwai etc.):
#   edu-lti-fallback-key-id      → LTI_FALLBACK_KEY_ID
#   edu-lti-fallback-private-key-pem → LTI_FALLBACK_PRIVATE_KEY_PEM
LTI_FALLBACK_KEY_ID=
LTI_FALLBACK_PRIVATE_KEY_PEM=

# Encrypts LMS API tokens and LTI platform private keys at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
# Deployed envs: KV secret 'edu-lms-secrets-encryption-key'.
# No fallback by design — never chain to JWT_SECRET (its 90-day rotation would
# make every stored secret undecryptable).
#
# Rotation — skipping a step loses the data permanently:
#   1. set KEY=<new> and KEY_PREVIOUS=<old>
#   2. deploy
#   3. npm run reencrypt:lms-secrets
#   4. remove KEY_PREVIOUS and redeploy
LMS_SECRETS_ENCRYPTION_KEY=

# Optional. Set only during a rotation; remove after step 3.
LMS_SECRETS_ENCRYPTION_KEY_PREVIOUS=

# ── Student-backend consolidation ────────────────────────────────────────
# Blob container for student uploads (distinct from AZURE_BLOB_CONTAINER_NAME's
# scenario/report JSON container). In deployed envs: KV secret 'edu-azure-blob-data-container-name'.
AZURE_BLOB_DATA_CONTAINER_NAME=rwai-data-files
# Bounded concurrency for scenario JSON hydration from blob storage.
SCENARIO_HYDRATION_CONCURRENCY=32
# Cache tuning for the scenario JSON data service.
JSON_CACHE_METADATA_CHECK_INTERVAL_MS=3000
LOCALIZED_SCENARIOS_CACHE_TTL_MS=30000

# ── Application Insights (telemetry analytics query API) ─────────────────
# Connection string for App Insights telemetry (in deployed envs this is
# resource-derived directly from the shared appi-all1-rwai resource, not KV).
APPLICATIONINSIGHTS_CONNECTION_STRING=
# 'api-key' for local dev, 'managed-identity' in deployed envs (uses AZURE_CLIENT_ID,
# which the backend's own user-assigned identity supplies — granted Monitoring Reader).
APPINSIGHTS_AUTH_TYPE=api-key
# Falls back to extracting ApplicationId from APPLICATIONINSIGHTS_CONNECTION_STRING if unset.
APPLICATIONINSIGHTS_APP_ID=
APPLICATIONINSIGHTS_API_KEY=
AZURE_CLIENT_ID=

# ── Lifecycle telemetry ────────────────────────────────────────────────────
TELEMETRY_SAMPLING_PRIORITY=100
TELEMETRY_LIFECYCLE_ENABLED=true

# ── AI conversation ─────────────────────────────────────────────────────────
CONVERSATION_PROVIDER=ai
AI_MODEL=gpt-4o
# In deployed envs: KV secret 'edu-openai-api-key', seeded with the same value
# as HS-Online-AI's shared 'OPENAI-API-KEY' secret (same OpenAI account/key).
OPENAI_API_KEY=

# ── Speech engine (Phase 2 — not yet active) ────────────────────────────────
SPEECH_ENGINE_PROVIDER=openai-whisper
SPEECH_ENGINE_API_KEY=
SPEECH_ENGINE_API_URL=
SPEECH_ENGINE_MODEL=
SPEECH_ENGINE_LANGUAGE=en-US

# ── Report email (SMTP) ──────────────────────────────────────────────────────
REPORT_EMAIL_TO=
EMAIL_MODE=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
