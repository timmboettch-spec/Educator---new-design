{
  "name": "reality-works-backend",
  "version": "2.4.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,apps,libs,test,tests}/**/*.{ts,js,mjs,json}\"",
    "format:check": "prettier --check \"{src,apps,libs,test,tests}/**/*.{ts,js,mjs,json}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "report:unit:generate": "node -e \"const fs=require('fs');fs.rmSync('./tests/unit/reports',{recursive:true,force:true});fs.mkdirSync('./tests/unit/reports',{recursive:true})\" && jest --json --outputFile=./tests/unit/reports/test-results.json && node tests/unit/reporters/generate-unit-test-report.mjs",
    "report:unit:show": "cmd /c start tests\\unit\\reports\\index.html",
    "report:integration:generate": "node -e \"const fs=require('fs');fs.rmSync('./tests/integration/reports',{recursive:true,force:true});fs.mkdirSync('./tests/integration/reports',{recursive:true})\" && jest --config ./tests/jest-integration.json --json --outputFile=./tests/integration/reports/test-results.json && node tests/integration/reporters/generate-integration-test-report.mjs",
    "report:integration:show": "cmd /c start tests\\integration\\reports\\index.html",
    "report:lint:generate": "node tests/lint/reporters/generate-eslint-report.mjs",
    "report:lint:show": "cmd /c start tests\\lint\\reports\\index.html",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./tests/jest-e2e.json",
    "test:integration": "jest --config ./tests/jest-integration.json && jest --config tests/student-backend/integration/config/jest.integration.json",
    "test:integration:lms-live": "jest --config ./tests/jest-integration-lms-live.json --runInBand",
    "test:api": "jest --config tests/api/config/jest.api.json --runInBand --forceExit && jest --config tests/student-backend/api/config/jest.api.json --runInBand --forceExit",
    "test:api:smoke": "jest --config tests/api/config/jest.smoke.config.json --runInBand --forceExit && jest --config tests/student-backend/api/config/jest.smoke.config.json --runInBand --forceExit",
    "test:unit": "jest && jest --config tests/student-backend/unit/config/jest.unit.json",
    "test:api:publish": "jest --config tests/api/jest.smoke.config.ts --runInBand --forceExit",
    "typeorm": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "typeorm:prod": "node ./node_modules/typeorm/cli.js -d dist/database/data-source.js",
    "migration:generate": "npm run typeorm -- migration:generate src/database/migrations/$npm_config_name",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run:dev": "npm run typeorm -- migration:run",
    "migration:run": "npm run typeorm:prod -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "reencrypt:lms-secrets:dev": "node -r ts-node/register -r tsconfig-paths/register src/scripts/reencrypt-lms-secrets.ts",
    "reencrypt:lms-secrets": "node dist/scripts/reencrypt-lms-secrets.js",
    "seed:prod": "node dist/database/seeders/index.js",
    "seed:local": "node -r ts-node/register -r tsconfig-paths/register src/database/seeders/index.ts"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/identity": "^4.4.1",
    "@azure/storage-blob": "^12.31.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.21",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.21",
    "@opentelemetry/api": "^1.9.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.23",
    "dotenv": "^17.2.4",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "nestjs-cls": "^6.2.0",
    "nestjs-i18n": "^10.8.5",
    "openai": "7.32.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.20.0",
    "pino": "^9.7.0",
    "prom-client": "npm:@prometheus-io/client@^0.16.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "xss": "^1.0.15"
  },
  "overrides": {
    "multer": "^2.4.0",
    "ws": "^8.21.0",
    "undici": "^6.27.0",
    "form-data": "^4.0.6",
    "socket.io-parser": "^4.2.7",
    "@nestjs/swagger": {
      "js-yaml": "^5.2.3"
    },
    "qs": "^6.16.0",
    "uuid": "^11.1.1",
    "fast-uri": "^3.1.8",
    "js-yaml@3": "^3.15.2",
    "js-yaml@4": "^4.3.2",
    "unzipper": "^0.12.5",
    "fast-csv": "^5.0.7",
    "archiver": "^7.0.1",
    "glob": "^13.0.6",
    "prom-client": "npm:@prometheus-io/client@^0.16.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.19",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "testMatch": [
      "**/tests/unit/**/*.spec.ts",
      "**/src/**/*.spec.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "reporters": [
      "default"
    ],
    "testTimeout": 30000,
    "maxWorkers": 1,
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ]
  }
}
