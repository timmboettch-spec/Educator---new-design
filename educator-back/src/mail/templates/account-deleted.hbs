<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Realityworks AI - Account Deleted</title>
</head>

<body style="margin: 0; padding: 24px 0; background-color: #e9edf2; font-family: Arial, Helvetica, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
        style="border-collapse: collapse;">
        <tr>
            <td align="center">
                <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0"
                    style="width: 560px; max-width: 560px; border-collapse: collapse; background-color: #ffffff; border-radius: 8px; overflow: hidden;">
                    <!-- Header -->
                    <tr>
                        <td style="padding: 24px; background-color: #6b7280;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                                style="border-collapse: collapse;">
                                <tr>
                                    <td align="center" style="padding: 12px;">
                                        <div
                                            style="background-color: #ffffff; padding: 12px; border-radius: 6px; display: inline-block;">
                                            {{#if logoUrl}}
                                            <img src="{{logoUrl}}" alt="Realityworks AI" width="180"
                                                style="display: block; border: 0; outline: none; text-decoration: none;" />
                                            {{else}}
                                            <img src="cid:realityworks-ai-logo" alt="Realityworks AI" width="180"
                                                style="display: block; border: 0; outline: none; text-decoration: none;" />
                                            {{/if}}
                                        </div>
                                    </td>
                                </tr>
                            </table>
                            <p
                                style="margin: 0; text-align: center; font-size: 30px; line-height: 1.2; font-weight: 600; color: #ffffff;">
                                Account Deleted</p>
                            <p
                                style="margin: 8px 0 0; text-align: center; font-size: 14px; line-height: 1.4; color: #ffffff;">
                                Your account has been removed</p>
                        </td>
                    </tr>

                    <!-- Body -->
                    <tr>
                        <td style="padding: 26px 24px 18px; background-color: #ffffff;">
                            <p style="margin: 0; font-size: 26px; line-height: 1.2; font-weight: 600; color: #1f2a37;">
                                Hi {{fullName}},</p>
                            <p style="margin: 14px 0 0; font-size: 14px; line-height: 1.6; color: #6b7280;">
                                Your Realityworks AI educator account has been <strong
                                    style="color: #1f2a37;">deleted</strong> by your administrator.
                                You will no longer be able to log in with this account.
                            </p>
                            <p style="margin: 10px 0 0; font-size: 14px; line-height: 1.6; color: #6b7280;">
                                If you believe this was a mistake or have any questions, please contact your
                                administrator.
                            </p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="padding: 16px 24px; background-color: #f9fafb; border-top: 1px solid #e5e7eb;">
                            <p
                                style="margin: 0; font-size: 12px; line-height: 1.5; color: #9ca3af; text-align: center;">
                                This email was sent by Realityworks AI. If you did not expect this change, please
                                contact support.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>