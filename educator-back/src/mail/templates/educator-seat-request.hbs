<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Educator Requested More AI Seats</title>
  </head>
  <body style="margin: 0; padding: 24px 0; background-color: #e9edf2; font-family: Arial, Helvetica, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="560"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="width: 560px; max-width: 560px; border-collapse: collapse; background-color: #ffffff; border-radius: 8px; overflow: hidden;"
          >
            <tr>
              <td style="padding: 16px 24px 14px; background-color: #eaac6d;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
                  <tr>
                    <td align="center" style="padding-bottom: 8px;">
                      {{#if logoUrl}}
                        <img src="{{logoUrl}}" alt="Realityworks AI" width="124" style="display: block; border: 0; outline: none; text-decoration: none;" />
                      {{else}}
                        <p style="margin: 0; text-align: center; font-size: 26px; line-height: 1.2; font-weight: 600; color: #ff6b00;">Realityworks AI</p>
                      {{/if}}
                    </td>
                  </tr>
                </table>
                <p style="margin: 0; text-align: center; font-size: 26px; line-height: 1.2; font-weight: 600; color: #ffffff;">Additional AI Seats Requested</p>
                <p style="margin: 4px 0 0; text-align: center; font-size: 13px; line-height: 1.35; color: #ffffff;">An educator is running low on AI simulation seats</p>
              </td>
            </tr>

            <tr>
              <td style="padding: 26px 24px 18px; background-color: #ffffff;">
                <p style="margin: 0; font-size: 22px; line-height: 1.2; font-weight: 600; color: #1f2a37;">Hi {{adminName}}</p>
                <p style="margin: 14px 0 0; font-size: 13px; line-height: 1.5; color: #6b7280;">
                  {{educatorName}} has requested additional AI simulation seats. Review the request details below and, if approved, allocate more seats from the admin portal.
                </p>

                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin-top: 18px; border-collapse: collapse; border: 1px solid #f0a15c; background-color: #fbf7f3;"
                >
                  <tr>
                    <td style="padding: 10px 14px 4px; width: 40%; font-size: 11px; line-height: 1.4; font-weight: 600; color: #ff6b00; text-transform: uppercase;">Educator</td>
                    <td style="padding: 10px 14px 4px; font-size: 13px; line-height: 1.4; color: #111827; font-weight: 500;">{{educatorName}}</td>
                  </tr>
                  <tr>
                    <td style="padding: 4px 14px; font-size: 11px; line-height: 1.4; font-weight: 600; color: #ff6b00; text-transform: uppercase;">Email</td>
                    <td style="padding: 4px 14px; font-size: 13px; line-height: 1.4; color: #111827; font-weight: 500;">{{educatorEmail}}</td>
                  </tr>
                  {{#if schoolName}}
                  <tr>
                    <td style="padding: 4px 14px; font-size: 11px; line-height: 1.4; font-weight: 600; color: #ff6b00; text-transform: uppercase;">School</td>
                    <td style="padding: 4px 14px; font-size: 13px; line-height: 1.4; color: #111827; font-weight: 500;">{{schoolName}}</td>
                  </tr>
                  {{/if}}
                  <tr>
                    <td style="padding: 4px 14px; font-size: 11px; line-height: 1.4; font-weight: 600; color: #ff6b00; text-transform: uppercase;">Seats Remaining</td>
                    <td style="padding: 4px 14px; font-size: 13px; line-height: 1.4; color: #111827; font-weight: 500;">{{remainingSeats}}</td>
                  </tr>
                  <tr>
                    <td style="padding: 4px 14px 10px; font-size: 11px; line-height: 1.4; font-weight: 600; color: #ff6b00; text-transform: uppercase;">Seats Requested</td>
                    <td style="padding: 4px 14px 10px; font-size: 13px; line-height: 1.4; color: #111827; font-weight: 500;">
                      {{#if requestedSeats}}{{requestedSeats}}{{else}}Not specified{{/if}}
                    </td>
                  </tr>
                </table>

                {{#if note}}
                <p style="margin: 16px 0 0; font-size: 11px; line-height: 1.4; font-weight: 600; color: #ff6b00; text-transform: uppercase;">Message from Educator</p>
                <p style="margin: 6px 0 0; padding: 10px 12px; border: 1px solid #f0a15c; background-color: #fffaf5; font-size: 13px; line-height: 1.5; color: #1f2a37; white-space: pre-wrap;">{{note}}</p>
                {{/if}}

                {{#if adminUrl}}
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse; margin-top: 20px;">
                  <tr>
                    <td align="center">
                      <a
                        href="{{adminUrl}}"
                        style="display: inline-block; min-width: 210px; padding: 12px 24px; background-color: #ff7a00; color: #ffffff; font-size: 14px; font-weight: 600; line-height: 1.2; text-decoration: none; border-radius: 6px;"
                      >
                        Manage Educator Seats
                      </a>
                    </td>
                  </tr>
                </table>
                {{/if}}

                <p style="margin: 16px 0 0; padding: 10px 12px; border: 1px solid #f0a15c; background-color: #fffaf5; font-size: 11px; line-height: 1.45; color: #6b7280;">
                  This is an automated notification triggered by the educator's request from the Realityworks AI dashboard.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
