<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ subject }}</title>
  </head>
  <body style="margin: 0; padding: 24px 0; background-color: #e9edf2; font-family: Arial, Helvetica, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="560"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="width: 560px; max-width: 560px; border-collapse: collapse; background-color: #ffffff; border-radius: 8px; overflow: hidden;"
          >
            <!-- Header -->
            <tr>
              <td style="padding: 16px 24px 14px; background-color: #eaac6d;">
                <p style="margin: 0; text-align: center; font-size: 26px; line-height: 1.2; font-weight: 600; color: #ff6b00;">Realityworks AI</p>
                <p style="margin: 6px 0 0; text-align: center; font-size: 33px; line-height: 1.2; font-weight: 600; color: #ffffff;">{{ subject }}</p>
                <p style="margin: 4px 0 0; text-align: center; font-size: 13px; line-height: 1.35; color: #ffffff;">A message from your educator</p>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding: 26px 24px 18px; background-color: #ffffff;">
                <p style="margin: 0; font-size: 26px; line-height: 1.2; font-weight: 600; color: #1f2a37;">Hi {{ studentName }},</p>
                <p style="margin: 14px 0 0; font-size: 13px; line-height: 1.5; color: #6b7280;">{{ message }}</p>

                <!-- Details Table -->
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin-top: 18px; border-collapse: collapse; border: 1px solid #f0a15c; background-color: #fbf7f3;"
                >
                  <tr>
                    <td style="padding: 10px 14px 4px; width: 36%; font-size: 11px; line-height: 1.4; font-weight: 600; color: #ff6b00; text-transform: uppercase;">Student Name</td>
                    <td style="padding: 10px 14px 4px; font-size: 13px; line-height: 1.4; color: #111827; font-weight: 500;">{{ studentName }}</td>
                  </tr>
                  <tr>
                    <td style="padding: 4px 14px 10px; width: 36%; font-size: 11px; line-height: 1.4; font-weight: 600; color: #ff6b00; text-transform: uppercase;">Class</td>
                    <td style="padding: 4px 14px 10px; font-size: 13px; line-height: 1.4; color: #111827; font-weight: 500;">{{ className }}</td>
                  </tr>
                </table>

                <!-- Access Code -->
                {{#if accessCode}}
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin-top: 20px; border-collapse: collapse;"
                >
                  <tr>
                    <td align="center" style="padding: 18px; background-color: #fff8f2; border: 1px solid #f0a15c; border-radius: 6px;">
                      <p style="margin: 0 0 6px; font-size: 11px; font-weight: 600; color: #ff6b00; text-transform: uppercase; letter-spacing: 1px;">Your Access Code</p>
                      <p style="margin: 0; font-size: 32px; font-weight: 700; color: #ff6b00; letter-spacing: 8px;">{{ accessCode }}</p>
                    </td>
                  </tr>
                </table>
                {{/if}}

                <p style="margin: 16px 0 0; padding: 10px 12px; border: 1px solid #f0a15c; background-color: #fffaf5; font-size: 11px; line-height: 1.45; color: #6b7280;">
                  If you did not expect this email, you can safely ignore it.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="padding: 14px 24px; background-color: #f9fafb; border-top: 1px solid #f0e8df;">
                <p style="margin: 0; text-align: center; font-size: 11px; color: #9ca3af;">© Realityworks AI · All rights reserved</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
