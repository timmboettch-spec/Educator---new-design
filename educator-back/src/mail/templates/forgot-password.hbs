<!DOCTYPE html>
<html>
<head>
<style>
body{
  font-family: Arial, sans-serif;
  color:#333;
  padding:20px;
  background:#f4f4f4;
}

.container{
  max-width:600px;
  margin:0 auto;
  background:#ffffff;
  border-radius:16px;
  overflow:hidden;
  border:1px solid #e5e5e5;
}

/* Header Design Only */
.header{
  background:linear-gradient(135deg,#fff8f2 0%, #ffe5cc 50%, #ffd1a3 100%);
  padding:28px;
  text-align:center;
}

h2{
  color:#1f2937;
  font-size:34px;
  text-align:center;
  margin:30px 0 20px;
}

.content{
  padding:0 35px 35px;
}

p{
  font-size:16px;
  line-height:1.7;
}

/* OTP Box Improved Design */
.otp-box{
  display:inline-block;
  font-size:32px;
  font-weight:bold;
  color:#ff6b00;
  letter-spacing:8px;
  background:#fff8f2;
  padding:18px 34px;
  border-radius:12px;
  margin:16px 0;
  border:1px solid #ffd5b0;
}

.expiry{
  color:#ff6b00;
  font-size:13px;
}

hr{
  margin:24px 0;
  border:none;
  border-top:1px solid #eee;
}

.footer{
  color:#999;
  font-size:12px;
  text-align:center;
  padding-bottom:20px;
}
</style>
</head>

<body>
<div class="container">

<div class="header">
  <img src="YOUR_LOGO_URL_HERE" width="70" style="vertical-align:middle;">
</div>

<div class="content">
  <h2>Password Reset Request</h2>

  <p>Hi,</p>

  <p>We received a request to reset your password. Use the OTP below to proceed:</p>

  <div style="text-align:center;">
    <div class="otp-box">{{otp}}</div>
  </div>

  <p class="expiry">This OTP expires in <strong>{{expiryMinutes}} minutes</strong>.</p>

  <p>If you did not request a password reset, please ignore this email.</p>

  <hr />

  <p class="footer">For security reasons, do not share this OTP with anyone.</p>
</div>

</div>
</body>
</html>