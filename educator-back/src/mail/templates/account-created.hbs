<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Realityworks AI - Administrator Account Created</title>
</head>

<body style="margin: 0; padding: 24px 0; background-color: #e9edf2; font-family: Arial, Helvetica, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
        style="border-collapse: collapse;">
        <tr>
            <td align="center">
                <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0"
                    style="width: 560px; max-width: 560px; border-collapse: collapse; background-color: #ffffff; border-radius: 8px; overflow: hidden;">

                    <!-- Header -->
                    <tr>
                        <td style="padding: 24px; background-color: #db8833;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                                style="border-collapse: collapse;">
                                <tr>
                                    <td align="center" style="padding: 12px;">
                                        <div
                                            style="background-color: #ffffff; padding: 12px; border-radius: 6px; display: inline-block;">
                                            <img src="cid:realityworks-ai-logo" alt="Realityworks AI" width="180"
                                                style="display: block; border: 0; outline: none; text-decoration: none;" />
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <p
                                style="margin: 0; text-align: center; font-size: 30px; line-height: 1.2; font-weight: 600; color: #ffffff;">
                                Administrator Account Created
                            </p>

                            <p
                                style="margin: 8px 0 0; text-align: center; font-size: 14px; line-height: 1.4; color: #ffffff;">
                                Welcome to Realityworks AI
                            </p>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding: 32px 24px; background-color: #ffffff;">

                            <p style="margin: 0; font-size: 24px; line-height: 1.3; font-weight: 600; color: #1f2937;">
                                Hi {{fullName}},
                            </p>

                            <p style="margin: 16px 0 0; font-size: 14px; line-height: 1.6; color: #4b5563;">
                                Your Realityworks AI administrator account has been successfully created and is ready
                                to use.
                            </p>

                            <p style="margin: 12px 0 0; font-size: 14px; line-height: 1.6; color: #4b5563;">
                                You can sign in using the username and password you created during the account setup
                                process.
                            </p>

                            <!-- Account Details -->
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                                style="margin-top: 24px; border-collapse: collapse; border: 1px solid #db8833; border-radius: 6px; overflow: hidden;">

                                <tr>
                                    <td
                                        style="padding: 14px; width: 35%; background-color: #faf6f1; font-size: 12px; font-weight: 600; color: #db8833; text-transform: uppercase;">
                                        Username:
                                    </td>

                                    <td
                                        style="padding: 14px; font-size: 14px; color: #111827; font-weight: 500; word-break: break-word;">
                                        {{username}}
                                    </td>
                                </tr>

                                <tr>
                                    <td
                                        style="padding: 14px; width: 35%; background-color: #faf6f1; font-size: 12px; font-weight: 600; color: #db8833;">
                                        LOGIN ADDRESS:
                                    </td>

                                    <td
                                        style="padding: 14px; font-size: 14px; color: #111827; font-weight: 500; word-break: break-all;">
                                        {{loginUrl}}
                                    </td>
                                </tr>
                            </table>

                            <!-- Login Button -->
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                                style="border-collapse: collapse; margin-top: 28px;">
                                <tr>
                                    <td align="center">
                                        <a href="{{loginUrl}}"
                                            style="display: inline-block; min-width: 220px; padding: 14px 28px; background-color: #db8833; color: #ffffff; font-size: 14px; font-weight: 600; line-height: 1.2; text-decoration: none; border-radius: 6px;">
                                            Sign In to Realityworks AI
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <!-- Login Instructions -->
                            <div
                                style="margin-top: 24px; padding: 14px; border: 1px solid #db8833; background-color: #fffaf5; border-radius: 4px;">
                                <p style="margin: 0; font-size: 12px; line-height: 1.6; color: #4b5563;">
                                    <strong style="color: #1f2937;">Login Instructions:</strong><br />
                                    Use the username listed above and the password you created during account setup to
                                    access your Realityworks AI account.
                                </p>
                            </div>

                            <p
                                style="margin: 28px 0 0; font-size: 12px; line-height: 1.6; color: #6b7280; text-align: center;">
                                If you have any issues signing in, please contact the support team at
                                <a href="mailto:{{supportEmail}}"
                                    style="color: #db8833; text-decoration: none; font-weight: 600;">
                                    {{supportEmail}}
                                </a>.
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>

</html>
```