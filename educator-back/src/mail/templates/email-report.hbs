<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Report</title>
  </head>
  <body style="margin: 0; padding: 18px; background-color: #efefef; font-family: Arial, Helvetica, sans-serif;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse: collapse;">
      <tr>
        <td align="center">
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="820" style="width: 820px; max-width: 820px; border-collapse: collapse; background-color: #ffffff; border: 1px solid #e5e5e5;">
            <tr>
              <td style="padding: 24px 24px 8px;">
                <p style="margin: 0; font-size: 38px; line-height: 1.3; font-weight: 700; color: #ff6b00;">
                  {{#if message}}{{message}}{{else}}Please find your report.{{/if}}
                </p>
              </td>
            </tr>

            <tr>
              <td style="padding: 4px 24px 8px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
                  <tr>
                    <td style="padding: 8px 18px 8px 0; font-size: 24px; color: #5a5a5a; font-weight: 700;">Class ID</td>
                    <td style="padding: 8px 0; font-size: 24px; color: #7a7a7a; font-weight: 600;">{{studentId}}</td>
                  </tr>
                  <tr>
                    <td style="padding: 8px 18px 8px 0; font-size: 24px; color: #5a5a5a; font-weight: 700;">Class</td>
                    <td style="padding: 8px 0; font-size: 24px; color: #7a7a7a; font-weight: 600;">{{className}}</td>
                  </tr>
                  {{#if scenarioTitle}}
                  <tr>
                    <td style="padding: 8px 18px 8px 0; font-size: 24px; color: #5a5a5a; font-weight: 700;">Simulation</td>
                    <td style="padding: 8px 0; font-size: 24px; color: #7a7a7a; font-weight: 600;">{{scenarioTitle}}</td>
                  </tr>
                  {{/if}}
                  <tr>
                    <td style="padding: 8px 18px 8px 0; font-size: 24px; color: #5a5a5a; font-weight: 700;">From Date</td>
                    <td style="padding: 8px 0; font-size: 24px; color: #7a7a7a; font-weight: 600;">-</td>
                  </tr>
                  <tr>
                    <td style="padding: 8px 18px 8px 0; font-size: 24px; color: #5a5a5a; font-weight: 700;">To Date</td>
                    <td style="padding: 8px 0; font-size: 24px; color: #7a7a7a; font-weight: 600;">-</td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding: 12px 24px 24px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse: collapse;">
                  <tr style="background-color: #f57a00;">
                    <th align="left" style="padding: 12px 14px; font-size: 16px; color: #ffffff; font-weight: 700;">Student Name</th>
                    <th align="left" style="padding: 12px 14px; font-size: 16px; color: #ffffff; font-weight: 700;">Score</th>
                    <th align="left" style="padding: 12px 14px; font-size: 16px; color: #ffffff; font-weight: 700;">Attempts</th>
                    <th align="left" style="padding: 12px 14px; font-size: 16px; color: #ffffff; font-weight: 700;">Time Spent</th>
                    <th align="left" style="padding: 12px 14px; font-size: 16px; color: #ffffff; font-weight: 700;">Sims Completed</th>
                    <th align="left" style="padding: 12px 14px; font-size: 16px; color: #ffffff; font-weight: 700;">Status</th>
                  </tr>
                  <tr style="background-color: #f2f2f2;">
                    <td style="padding: 11px 14px; font-size: 18px; color: #6c6c6c; font-weight: 600;">{{studentName}}</td>
                    <td style="padding: 11px 14px; font-size: 18px; color: #8a8a8a; font-weight: 600;">{{score}}</td>
                    <td style="padding: 11px 14px; font-size: 18px; color: #8a8a8a; font-weight: 600;">{{attempt}}</td>
                    <td style="padding: 11px 14px; font-size: 18px; color: #8a8a8a; font-weight: 600;">{{timeSpent}}</td>
                    <td style="padding: 11px 14px; font-size: 18px; color: #8a8a8a; font-weight: 600;">{{simsCompleted}}</td>
                    <td style="padding: 11px 14px; font-size: 18px; color: #6c6c6c; font-weight: 700;">
                      {{#if timeRemaining}}{{timeRemaining}}{{else}}ACTIVE{{/if}}
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
