<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Realityworks AI - You're Invited</title>
</head>

<body style="margin: 0; padding: 24px 0; background-color: #e9edf2; font-family: Arial, Helvetica, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
    <tr>
      <td align="center">
        <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0"
          style="width: 560px; max-width: 560px; border-collapse: collapse; background-color: #ffffff; border-radius: 8px; overflow: hidden;">

          <!-- Header -->
          <tr>
            <td style="padding: 24px; background-color: #db8833;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                style="border-collapse: collapse;">
                <tr>
                  <td align="center" style="padding: 12px;">
                    <div style="background-color: #ffffff; padding: 12px; border-radius: 6px; display: inline-block;">
                      {{#if logoUrl}}
                      <img src="{{logoUrl}}" alt="Realityworks AI" width="180"
                        style="display: block; border: 0; outline: none; text-decoration: none;" />
                      {{else}}
                      <img src="cid:realityworks-ai-logo" alt="Realityworks AI" width="180"
                        style="display: block; border: 0; outline: none; text-decoration: none;" />
                      {{/if}}
                    </div>
                  </td>
                </tr>
              </table>

              <p
                style="margin: 0; text-align: center; font-size: 30px; line-height: 1.2; font-weight: 600; color: #ffffff;">
                You're Invited!
              </p>

              <p style="margin: 8px 0 0; text-align: center; font-size: 14px; line-height: 1.4; color: #ffffff;">
                Join your school on Realityworks
              </p>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding: 32px 24px; background-color: #ffffff;">

              <p style="margin: 0; font-size: 24px; line-height: 1.3; font-weight: 600; color: #1f2937;">
                Hi {{fullName}}
              </p>

              <p style="margin: 16px 0 0; font-size: 14px; line-height: 1.6; color: #4b5563;">
                You've been invited to join as an Educator. Here are your invitation details:
              </p>

              <!-- Invite Details -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                style="margin-top: 24px; border-collapse: separate; border: 1px solid #db8833; border-radius: 6px;">
                <tr>
                  <td style="padding: 0;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                      style="border-collapse: collapse;">
                      <tr>
                        <td
                          style="padding: 14px; width: 35%; background-color: #faf6f1; font-size: 12px; font-weight: 600; color: #db8833; text-transform: uppercase; border-radius: 6px 0 0 0;">
                          School:
                        </td>

                        <td style="padding: 14px; background-color: #faf6f1; font-size: 14px; color: #111827; font-weight: 500; word-break: break-word; border-radius: 0 6px 0 0;">
                          {{schoolName}}
                        </td>
                      </tr>

                      <tr>
                        <td
                          style="padding: 14px; width: 35%; background-color: #faf6f1; font-size: 12px; font-weight: 600; color: #db8833; text-transform: uppercase;">
                          Invited By:
                        </td>

                        <td style="padding: 14px; background-color: #faf6f1; font-size: 14px; color: #111827; font-weight: 500; word-break: break-word;">
                          {{creatorName}}
                        </td>
                      </tr>

                      <tr>
                        <td
                          style="padding: 14px; width: 35%; background-color: #faf6f1; font-size: 12px; font-weight: 600; color: #db8833; text-transform: uppercase; border-radius: 0 0 0 6px;">
                          Role:
                        </td>

                        <td style="padding: 14px; background-color: #faf6f1; font-size: 14px; color: #111827; font-weight: 500; word-break: break-word; border-radius: 0 0 6px 0;">
                          Educator
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Accept Invitation Button -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                style="margin-top: 24px; border-collapse: collapse;">
                <tr>
                  <td align="center">
                    <a href="{{inviteUrl}}"
                      style="display: inline-block; min-width: 190px; padding: 12px 32px; background-color: #db8833; color: #ffffff; font-size: 14px; font-weight: 600; line-height: 1.2; text-decoration: none; border-radius: 6px;">
                      Accept Invitation
                    </a>
                  </td>
                </tr>
              </table>

              <p
                style="margin: 24px 0 0; padding: 12px 14px; border: 1px solid #db8833; border-radius: 6px; background-color: #faf6f1; font-size: 14px; line-height: 1.6; color: #4b5563;">
                If you did not expect this invitation, you can safely ignore this email. No account will be created
                without your action.
              </p>

              <hr style="margin: 24px 0; border: none; border-top: 1px solid #e5e7eb;" />

              <p style="margin: 0; font-size: 12px; line-height: 1.6; color: #db8833; text-align: center;">
                Expires in <strong>{{#if expiryMinutes}}{{expiryMinutes}}{{else}}60{{/if}} minute(s)</strong>.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>

</html>