{
  "name": "reality-works-frontend",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:integration": "vitest run --reporter=verbose tests/integration",
    "report:unit:generate": "vitest run tests/unit tests/components && node tests/unit/reporters/generate-unit-test-report.mjs",
    "report:unit:show": "cmd /c start tests\\unit\\reports\\index.html",
    "report:integration:generate": "node tests/integration/reporters/generate-integration-test-report.mjs",
    "report:integration:show": "cmd /c start tests\\integration\\reports\\index.html",
    "test:e2e:smoke": "playwright test --config=playwright.config.ts",
    "e2e:smoke": "playwright test --config=tests/e2e/config/playwright.smoke.config.ts",
    "test:e2e:regression": "playwright test --config=tests/e2e/config/playwright.regression.config.ts",
    "e2e:report": "node tests/e2e/open-report.mjs",
    "e2e:smoke:report": "node tests/e2e/open-report.mjs smoke",
    "e2e:regression:report": "node tests/e2e/open-report.mjs regression",
    "dev": "vite",
    "preview": "vite preview",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "lint": "eslint . --max-warnings=0",
    "lint:json": "eslint . -f json -o tests/lint/reports/eslint-results.json",
    "report:lint:generate": "node tests/lint/reporters/run-lint-report.mjs",
    "report:lint:show": "cmd /c start tests\\lint\\reports\\index.html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "*.{json,md,css,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-toast": "^1.2.15",
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.19.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "dompurify": "^3.4.12",
    "formik": "^2.4.9",
    "framer-motion": "^12.42.2",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.15",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.8.1",
    "redux": "^5.0.1",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.23",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.4.0",
    "mailosaur": "^11.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.9.7",
    "redux-mock-store": "^1.5.5",
    "redux-thunk": "^3.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  }
}
